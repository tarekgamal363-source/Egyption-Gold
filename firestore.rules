rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /complaints/{complaintId} {
      // أي حد مسجل دخول يقدر يبعت شكوى جديدة باسمه هو بس
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;

      // المستخدم يقدر يشوف بس رسايله هو
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // محدش من التطبيق نفسه يقدر يعدل أو يمسح (الرد بيتم من لوحة تحكم Firebase مباشرة)
      allow update, delete: if false;
    }

    // اشتراك الإشعارات: كل مستخدم يقرا ويكتب مستند اشتراكه هو بس
    match /push_subscribers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
